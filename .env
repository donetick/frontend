VITE_APP_API_URL=http://localhost:2021
VITE_IS_LANDING_DEFAULT=true
VITE_OPENREPLAY_PROJECT_KEY=
VITE_IS_SELF_HOSTED=false

# PostHog product analytics — all optional. Leave VITE_POSTHOG_KEY blank to
# disable analytics entirely (nothing loads, nothing is sent). See
# docs/analytics.md for setup and reverse-proxy guidance.
VITE_POSTHOG_KEY=
# Web ingestion host: a same-origin reverse-proxy path (e.g. /ingest), a
# PostHog managed-proxy domain (e.g. https://e.yourdomain.com), or a direct
# cloud host (https://us.i.posthog.com / https://eu.i.posthog.com).
VITE_POSTHOG_HOST=
# Native (Capacitor) ingestion host. MUST be an absolute URL — the native build
# has no same-origin backend, so a relative proxy path won't resolve.
VITE_POSTHOG_HOST_NATIVE=
# Only needed when the host above is a reverse proxy (US default assumed).
VITE_POSTHOG_UI_HOST=
