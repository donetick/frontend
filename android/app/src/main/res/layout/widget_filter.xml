<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filter_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/filter_counts"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textSize="10sp" />

    <!-- Let task names use the full widget width. Keeping controls in a fixed
         side rail left almost no title space in narrow 2-column widgets. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/filter_row_0" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/filter_check_0" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/filter_task_0" style="@style/ProjectWidgetTask"/></LinearLayout>
        <LinearLayout android:id="@+id/filter_row_1" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/filter_check_1" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/filter_task_1" style="@style/ProjectWidgetTask"/></LinearLayout>
        <LinearLayout android:id="@+id/filter_row_2" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/filter_check_2" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/filter_task_2" style="@style/ProjectWidgetTask"/></LinearLayout>
        <LinearLayout android:id="@+id/filter_row_3" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/filter_check_3" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/filter_task_3" style="@style/ProjectWidgetTask"/></LinearLayout>
        <LinearLayout android:id="@+id/filter_row_4" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/filter_check_4" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/filter_task_4" style="@style/ProjectWidgetTask"/></LinearLayout>

        <TextView
            android:id="@+id/filter_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="No tasks in this filter"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- A single compact control row scales to the available width instead of
         reserving 102dp beside every task row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filter_previous"
            style="@style/ProjectWidgetButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="Previous filter"
            android:text="‹" />

        <TextView
            android:id="@+id/filter_up"
            style="@style/ProjectWidgetButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="Previous tasks"
            android:text="▲"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/filter_refresh"
            style="@style/ProjectWidgetButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="Refresh"
            android:text="↻" />

        <TextView
            android:id="@+id/filter_down"
            style="@style/ProjectWidgetButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="Next tasks"
            android:text="▼"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/filter_next"
            style="@style/ProjectWidgetButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="Next filter"
            android:text="›" />
    </LinearLayout>
</LinearLayout>
