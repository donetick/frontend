<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- The circle and the glyph are both fitCenter ImageViews: the cell is
                 rarely square, and fitCenter keeps each drawable's own aspect ratio
                 instead of stretching it to the cell like a background would. -->
            <FrameLayout
                android:id="@+id/action_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:contentDescription="@null">

                <ImageView
                    android:id="@+id/action_0_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_action_tile" />

                <ImageView
                    android:id="@+id/action_0_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_add" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/action_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:contentDescription="@null">

                <ImageView
                    android:id="@+id/action_1_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_action_tile" />

                <ImageView
                    android:id="@+id/action_1_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_mic" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <FrameLayout
                android:id="@+id/action_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:contentDescription="@null">

                <ImageView
                    android:id="@+id/action_2_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_action_tile" />

                <ImageView
                    android:id="@+id/action_2_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_scan" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/action_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:contentDescription="@null">

                <ImageView
                    android:id="@+id/action_3_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_action_tile" />

                <ImageView
                    android:id="@+id/action_3_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_search" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
