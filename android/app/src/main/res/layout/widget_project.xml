<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/project_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: project identity and all top-level actions share one row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/project_icon"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="●"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/project_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/project_previous"
            style="@style/ProjectWidgetButton"
            android:contentDescription="Previous project"
            android:text="‹" />
        <TextView
            android:id="@+id/project_next"
            style="@style/ProjectWidgetButton"
            android:contentDescription="Next project"
            android:text="›" />
        <TextView
            android:id="@+id/project_refresh"
            style="@style/ProjectWidgetButton"
            android:contentDescription="Refresh"
            android:text="↻" />
    </LinearLayout>

    <TextView
        android:id="@+id/project_counts"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingEnd="6dp">
            <LinearLayout android:id="@+id/project_row_0" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/project_check_0" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/project_task_0" style="@style/ProjectWidgetTask"/></LinearLayout>
            <LinearLayout android:id="@+id/project_row_1" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/project_check_1" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/project_task_1" style="@style/ProjectWidgetTask"/></LinearLayout>
            <LinearLayout android:id="@+id/project_row_2" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/project_check_2" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/project_task_2" style="@style/ProjectWidgetTask"/></LinearLayout>
            <LinearLayout android:id="@+id/project_row_3" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/project_check_3" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/project_task_3" style="@style/ProjectWidgetTask"/></LinearLayout>
            <LinearLayout android:id="@+id/project_row_4" style="@style/ProjectWidgetRow"><ImageView android:id="@+id/project_check_4" style="@style/ProjectWidgetCheck"/><TextView android:id="@+id/project_task_4" style="@style/ProjectWidgetTask"/></LinearLayout>

            <TextView
                android:id="@+id/project_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="No tasks in this project"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Up/down stay in the column directly below the header refresh action. -->
        <LinearLayout
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical">
            <TextView
                android:id="@+id/project_up"
                style="@style/ProjectWidgetButton"
                android:contentDescription="Previous tasks"
                android:text="▲"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/project_down"
                style="@style/ProjectWidgetButton"
                android:contentDescription="Next tasks"
                android:text="▼"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
